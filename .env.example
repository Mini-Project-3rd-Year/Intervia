# ============================================================
# INTERVIA — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ---- Application ------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# ---- Backend API ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ---------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intervia

# ---- Supabase (for Auth + DB in cloud) -------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- AI / LLM ---------------------------------------------
# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (fallback / alternative)
OPENAI_API_KEY=your-openai-api-key

# LLM provider to use: "gemini" | "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-exp

# ---- Embeddings -------------------------------------------
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# ---- RAG / Vector Store -----------------------------------
PGVECTOR_CONNECTION_URL=postgresql://postgres:password@localhost:5432/intervia

# ---- Voice / Speech ---------------------------------------
# Speech-to-Text provider: "google" | "deepgram" | "openai-whisper"
STT_PROVIDER=google
GOOGLE_STT_API_KEY=your-google-stt-key

# Text-to-Speech provider: "google" | "elevenlabs" | "openai"
TTS_PROVIDER=google
GOOGLE_TTS_API_KEY=your-google-tts-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ---- Auth / JWT -------------------------------------------
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- File Storage -----------------------------------------
# "local" | "s3" | "supabase-storage"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- S3 (if using AWS or compatible) ----------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=intervia-uploads

# ---- Frontend (Vite) --------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_ENV=development
